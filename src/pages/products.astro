---
// pages/products.astro
// Página de productos de SANDA
// Incluye un contenedor preparado para mostrar productos con scroll horizontal/vertical
// Estructura lista para insertar elementos dinámicamente

import Layout from '../layouts/Layout.astro';
---

<Layout>
  {/* Sección principal de productos */}
  <section class="products-section">
    <h2 class="products-section__title">Products</h2>
    
    {/* Contenedor de scroll para los elementos de productos */}
    {/* Este contenedor está vacío ahora y listo para rellenarse con productos */}
    {/* Puedes agregar elementos <div class="product-item">...</div> aquí */}
    <div class="products-container">
      {/* Los productos irán aquí */}
      {/* Ejemplo: <div class="product-item">Producto 1</div> */}
    </div>
  </section>
</Layout>

<style>
  {/* Sección de productos - contenedor principal */}
  .products-section {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  {/* Título de la sección de productos */}
  .products-section__title {
    font-size: 2rem;
    font-weight: 600;
    margin-bottom: 2rem;
    text-align: center;
  }

  {/* Contenedor con scroll - preparado para múltiples elementos */}
  {/* Usa overflow para crear scroll cuando hay muchos elementos */}
  .products-container {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    justify-content: center;
    align-items: flex-start;
    min-height: 400px;
    padding: 1rem;
    overflow-y: auto;
    max-height: 600px;
  }

  {/* Estilos base para cada item de producto (cuando se agreguen) */}
  .product-item {
    min-width: 250px;
    padding: 1rem;
    border: 1px solid #ddd;
    border-radius: 8px;
    background: #f9f9f9;
    text-align: center;
  }

  {/* Media query para dispositivos móviles */}
  @media (max-width: 768px) {
    .products-section__title {
      font-size: 1.5rem;
    }

    .products-container {
      max-height: 100%;
      overflow-y: visible;
    }
  }
</style>
