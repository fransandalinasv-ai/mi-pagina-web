---
// pages/art.astro
// Página de arte de SANDA
// Incluye un contenedor con CSS Grid preparado para mostrar un feed de imágenes
// El Grid se adapta automáticamente según el tamaño de pantalla

import Layout from '../layouts/Layout.astro';
---

<Layout>
  {/* Sección principal de arte */}
  <section class="art-section">
    <h2 class="art-section__title">Art</h2>
    
    {/* Contenedor Grid para mostrar el feed de imágenes */}
    {/* Este contenedor está vacío ahora y listo para insertar imágenes */}
    {/* Las imágenes se distribuirán automáticamente en un grid responsivo */}
    <div class="art-gallery">
      {/* Las imágenes irán aquí */}
      {/* Ejemplo: <img src="ruta/imagen.jpg" alt="Descripción" class="art-item"> */}
    </div>
  </section>
</Layout>

<style>
  {/* Sección de arte - contenedor principal */}
  .art-section {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  {/* Título de la sección de arte */}
  .art-section__title {
    font-size: 2rem;
    font-weight: 600;
    margin-bottom: 2rem;
    text-align: center;
  }

  {/* Contenedor Grid para el feed de imágenes */}
  {/* auto-fit: adapta el número de columnas automáticamente */}
  {/* minmax(250px, 1fr): cada celda tiene mínimo 250px y se expande proporcionalmente */}
  {/* gap: espacio entre elementos */}
  .art-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    min-height: 400px;
  }

  {/* Estilos base para cada item de arte (imagen) */}
  .art-item {
    width: 100%;
    height: 250px;
    object-fit: cover;
    border-radius: 8px;
    background: #f0f0f0;
    transition: transform 0.3s ease;
  }

  {/* Efecto hover suave en las imágenes */}
  .art-item:hover {
    transform: scale(1.05);
  }

  {/* Media query para tablets */}
  @media (max-width: 768px) {
    .art-section__title {
      font-size: 1.5rem;
    }

    .art-gallery {
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
    }

    .art-item {
      height: 200px;
    }
  }

  {/* Media query para móviles */}
  @media (max-width: 480px) {
    .art-gallery {
      grid-template-columns: 1fr;
    }

    .art-item {
      height: 300px;
    }
  }
</style>
