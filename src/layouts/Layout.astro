---
// Layout.astro
// Componente de layout base/chasis que estructuran todas las páginas
// Importa el Header y proporciona el slot para inyectar contenido dinámico.
// Este es el "wrapper" que garantiza consistencia visual en toda la web.

import Header from '../components/Header.astro';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SANDA</title>
  </head>
  
  <body>
    {/* Importar el componente Header que aparece en todas las páginas */}
    <Header />
    
    {/* Contenedor principal donde se inyecta el contenido dinámico de cada página */}
    {/* El <slot /> actúa como un placeholder que será reemplazado por el contenido */}
    {/* de cada página que use este Layout */}
    <main class="main-content">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  {/* Estilos globales aplicados a toda la web */}
  
  /* Reset de estilos del navegador para consistencia */
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  /* Estilos base del documento */
  html, body {
    width: 100%;
    height: 100%;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: #333;
  }

  {/* Contenedor principal de contenido - ocupa el espacio disponible */}
  .main-content {
    flex: 1;
    width: 100%;
    padding: 2rem 1rem;
    min-height: calc(100vh - 200px);
  }

  {/* Asegurar que el body sea flex para distribuir espacios */}
  body {
    display: flex;
    flex-direction: column;
  }
</style>
